# ─── Langfuse Observability ──────────────────────────────────────────────────
# Get these from https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST="https://cloud.langfuse.com"   # or your self-hosted URL

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── Token & Rate Limits ─────────────────────────────────────────────────────
MAX_PROMPT_LENGTH=4000          # Max characters in a single user message
MAX_RESPONSE_TOKENS=1024        # Max tokens in an AI response
DAILY_REQUEST_LIMIT=100         # Max requests per user per day
MAX_CONVERSATION_TOKENS=8000    # Max total tokens in a conversation

# ─── App Settings ─────────────────────────────────────────────────────────────
ENVIRONMENT="development"
DATABASE_URL="sqlite:///./chatbot.db"
BACKEND_PORT=8000
FRONTEND_PORT=5173
MOCK_LLM=false                   # Set to true to bypass OpenAI and use simulated responses
